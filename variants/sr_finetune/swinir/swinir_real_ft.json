// SwinIR-M real-world x4 GAN fine-tuned on MatSynth - external/KAIR/options/swinir/
// train_swinir_sr_realworld_x4_gan.json (KAIR @ fc1732f) with ONLY the lines marked
// CHANGED / REMOVED altered. KAIR strips everything after "//" on each line, so these
// comments are legal; no value may contain "//". Trained by
// variants/sr_finetune/swinir/kair_train.py (run.ps1 -Stage train -Arm swinir_real):
// models land in runs/sr_ft/kair/swinir_real_ft/models/<N>_{G,E,D}.pth.
{
  "task": "swinir_real_ft"               // CHANGED (was swinir_sr_realworld_x4_gan)
  , "model": "gan"
  , "gpu_ids": [0]                       // CHANGED (was [0..7]): one GPU

  , "scale": 4
  , "n_channels": 3

  , "path": {
    "root": "/workspace/runs/sr_ft/kair"  // CHANGED (was superresolution)
    // All null as in the official file and ignored by KAIR (see swinir_cls_ft.json):
    // G and E start from models/0_G.pth + 0_E.pth, both the released params_ema of
    // 003_realSR_BSRGAN_DFO_s64w8_SwinIR-M_x4_GAN.pth (the only generator released);
    // D has no 0_D.pth and starts from scratch, as in the official recipe.
    , "pretrained_netG": null
    , "pretrained_netD": null
    , "pretrained_netE": null
  }

  , "datasets": {
    "train": {
      "name": "train_dataset"
      , "dataset_type": "blindsr"
      // CHANGED: the MatSynth HR maps (prep_pairs.py), five maps 1:1. LR is made on the
      // fly by the BSRGAN degradation, as official - NOT the area LR the arm is evaluated on.
      , "dataroot_H": "/workspace/runs/sr_ft/pairs/HR"
      , "dataroot_L": null

      , "degradation_type": "bsrgan"
      , "H_size": 256
      , "shuffle_prob": 0.1
      , "lq_patchsize": 64
      , "use_sharp": true

      , "dataloader_shuffle": true
      , "dataloader_num_workers": 8      // CHANGED (was 16)
      // CHANGED (was 32): the official total is 4 per GPU x 8 GPUs; one GPU at the official
      // per-GPU 4. 8 does not fit a 12 GB card (measured 2026-11-02: VRAM full, ~30 s/iter).
      , "dataloader_batch_size": 4
    }
    // REMOVED: "test" (Set5). No validation during training; see checkpoint_test.
  }

  , "netG": {
    "net_type": "swinir"
    , "upscale": 4
    , "in_chans": 3
    , "img_size": 64
    , "window_size": 8
    , "img_range": 1.0
    , "depths": [6, 6, 6, 6, 6, 6]
    , "embed_dim": 180
    , "num_heads": [6, 6, 6, 6, 6, 6]
    , "mlp_ratio": 2
    , "upsampler": "nearest+conv"
    , "resi_connection": "1conv"

    , "init_type": "default"
  }

  , "netD": {
    "net_type": "discriminator_unet"
    , "in_nc": 3
    , "base_nc": 64
    , "n_layers": 3
    , "norm_type": "spectral"

    , "init_type": "orthogonal"
    , "init_bn_type": "uniform"
    , "init_gain": 0.2
  }

  , "train": {
    "G_lossfn_type": "l1"
    , "G_lossfn_weight": 1

    , "F_lossfn_type": "l1"
    , "F_lossfn_weight": 1
    , "F_feature_layer": [2,7,16,25,34]
    , "F_weights": [0.1,0.1,1.0,1.0,1.0]
    , "F_use_input_norm": true
    , "F_use_range_norm": false

    , "gan_type": "gan"
    , "D_lossfn_weight": 0.1

    , "E_decay": 0.999

    , "D_init_iters": 0

    , "G_optimizer_type": "adam"
    , "G_optimizer_lr": 1e-4
    , "G_optimizer_wd": 0

    , "D_optimizer_type": "adam"
    , "D_optimizer_lr": 1e-4
    , "D_optimizer_wd": 0

    , "G_scheduler_type": "MultiStepLR"
    , "G_scheduler_milestones": [20000, 30000]   // CHANGED (was [400000, 500000, 550000, 575000, 600000])
    , "G_scheduler_gamma": 0.5
    , "G_optimizer_reuse": true

    , "D_scheduler_type": "MultiStepLR"
    , "D_scheduler_milestones": [20000, 30000]   // CHANGED (was [400000, 500000, 550000, 575000, 600000])
    , "D_scheduler_gamma": 0.5
    // Official false: D's Adam state is not saved, so a resumed run restarts D's optimizer.
    , "D_optimizer_reuse": false

    , "G_param_strict": true
    , "D_param_strict": true
    , "E_param_strict": true

    , "manual_seed": 0                   // ADDED: the official file leaves the seed random

    // CHANGED (was 5000): no test set, and the loop reads test_loader at every
    // checkpoint_test step (main_train_gan.py), so it must never be reached.
    , "checkpoint_test": 1000000000
    , "checkpoint_save": 5000
    , "checkpoint_print": 200
  }
}
