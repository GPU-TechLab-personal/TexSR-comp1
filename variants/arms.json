    "matsynth_all":       {"method": "deeptex", "display": "DeepTextures (matsynth_all)", "reference": null,
                           "config": "variants/deeptex/matsynth/esrgan_matsynth.yaml",
                           "checkpoint_root": "/workspace/runs/deeptex/matsynth_all/checkpoints"},
    "matsynth_chratio":   {"method": "deeptex", "display": "DeepTextures (matsynth_chratio)", "reference": "matsynth_all",
                           "config": "variants/deeptex/matsynth/esrgan_matsynth_chratio.yaml",
                           "checkpoint_root": "/workspace/runs/deeptex/matsynth_chratio/checkpoints"},
    "matsynth_basecolor": {"method": "deeptex", "display": "DeepTextures (matsynth_basecolor)", "reference": "matsynth_all",
                           "config": "variants/deeptex/matsynth/esrgan_matsynth_basecolor.yaml",
                           "checkpoint_root": "/workspace/runs/deeptex/matsynth_basecolor/checkpoints"},
    "render_r0a":         {"method": "deeptex", "display": "DeepTextures grouped (R0a)", "reference": "matsynth_all",
