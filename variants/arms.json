    "smoke_r0a":          {"method": "deeptex", "display": "smoke_r0a", "reference": null,
                           "config": "variants/deeptex/render_loss/r0a.yaml", "checkpoint_root": "{RSMOKE}/smoke_r0a/checkpoints"},
    "smoke_r1":           {"method": "deeptex", "display": "smoke_r1", "reference": null,
